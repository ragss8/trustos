{
  "name": "trustos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "boundaries": "depcruise \"apps/*/src\" \"packages/*/src\" \"integrations/*/src\" --config .dependency-cruiser.cjs",
    "typecheck": "tsc --build --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test",
    "clean": "tsc --build --clean",
    "db:migrate": "pnpm --filter @trustos/database db:migrate",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres redis && sleep 6 && pnpm db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
