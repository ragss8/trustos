# Local development. Never used outside docker-compose; no real secrets here.
POSTGRES_PORT=55432
REDIS_PORT=56379
KEYCLOAK_PORT=58080

# Migrations run as the table owner. This role is NOT used at runtime.
DATABASE_MIGRATION_URL="postgresql://trustos_migrator:local_dev_only@localhost:55432/trustos?schema=public"

# The application role. Non-owner, no BYPASSRLS, subject to row-level security.
# INVARIANT 5 depends on this being a different role from the one above.
DATABASE_URL="postgresql://trustos_app:local_dev_only@localhost:55432/trustos?schema=public"

REDIS_URL="redis://localhost:56379"
OIDC_ISSUER_URL="http://localhost:58080/realms/trustos"
