# ── TrustOS local development ────────────────────────────────────────────────
#
# Copy to .env (git-ignored). Everything here is local-only; there are no real
# secrets in this file and there must never be. Production values come from the
# managed secret store, never from a checked-in file.
#
#   cp .env.example .env && pnpm db:up && pnpm db:migrate

NODE_ENV=development
LOG_LEVEL=debug

# ── Ports ────────────────────────────────────────────────────────────────────
# Offset from the defaults: 5432 and 6379 are commonly already in use.
POSTGRES_PORT=55432
REDIS_PORT=56379
KEYCLOAK_PORT=58080
CONTROL_API_PORT=53001
DECISION_API_PORT=53002
CONSOLE_PORT=5173

# ── Database ─────────────────────────────────────────────────────────────────
# Three roles, three URLs, on purpose (architecture.md §6.1). Using the wrong one
# does not fail loudly — it silently disables tenant isolation, because a table
# owner and any BYPASSRLS role ignore row-level security.

# Superuser. Creates roles, runs migrations marked `-- @role: root`. Never at runtime.
DATABASE_ROOT_URL="postgresql://trustos_root:local_dev_only@localhost:55432/trustos"

# Owns the tables. Runs schema migrations. Never serves a request.
DATABASE_MIGRATION_URL="postgresql://trustos_migrator:local_dev_only@localhost:55432/trustos"

# THE APPLICATION ROLE. Non-owner, NOSUPERUSER, NOBYPASSRLS, so RLS applies to it.
# This is the only one the APIs and workers may use.
DATABASE_URL="postgresql://trustos_app:local_dev_only@localhost:55432/trustos"

# Cross-tenant job scheduling only. Sees claim columns on the outbox, no business
# rows; processing re-enters a normally scoped transaction as trustos_app.
DATABASE_DISPATCHER_URL="postgresql://trustos_dispatcher:local_dev_only@localhost:55432/trustos"

DATABASE_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────────────────────
# Accelerator only (INVARIANT 2). Losing it must never change a decision, an
# approval state or whether a grant was consumed.
REDIS_URL="redis://localhost:56379"

# ── Identity ─────────────────────────────────────────────────────────────────
OIDC_ISSUER_URL="http://localhost:58080/realms/trustos"
OIDC_AUDIENCE="trustos-api"

OIDC_CONSOLE_CLIENT_ID="trustos-console"

OIDC_GATEWAY_CLIENT_ID="trustos-gateway"
OIDC_GATEWAY_CLIENT_SECRET="local_dev_only_gateway"

OIDC_AGENT_CLIENT_ID="trustos-agent-sandbox"
OIDC_AGENT_CLIENT_SECRET="local_dev_only_agent"

# Keycloak admin console: http://localhost:58080 (admin / local_dev_only)
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="local_dev_only"

# ── Authority lifetimes ──────────────────────────────────────────────────────
# prd.md §8.1 defaults. Configurable DOWNWARD for a pilot; raising them needs
# review. A grant never outlives the request's business deadline regardless.
GRANT_TTL_SECONDS=60
APPROVAL_TTL_SECONDS=600
IDEMPOTENCY_RETENTION_HOURS=24

# Clock skew tolerated when validating tokens. Kept small: real drift is an alert,
# not something to absorb silently (architecture.md §13.2).
TOKEN_CLOCK_TOLERANCE_SECONDS=5
