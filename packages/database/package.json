{
  "name": "@trustos/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, SQL migrations, repositories, tenant transactions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env --experimental-strip-types scripts/migrate.ts",
    "db:reset": "docker compose down -v postgres && docker compose up -d postgres && sleep 6 && pnpm db:migrate",
    "db:seed": "node --env-file-if-exists=../../.env --experimental-strip-types scripts/seed.ts"
  },
  "dependencies": {
    "@trustos/contracts": "workspace:*",
    "@trustos/domain": "workspace:*",
    "@trustos/observability": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
