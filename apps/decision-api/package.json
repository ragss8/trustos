{
  "name": "@trustos/decision-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "authorize, decision read, grant consume, outcome APIs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "node --env-file-if-exists=../../.env --watch dist/main.js"
  },
  "dependencies": {
    "@trustos/auth": "workspace:*",
    "@trustos/contracts": "workspace:*",
    "@trustos/database": "workspace:*",
    "@trustos/domain": "workspace:*",
    "@trustos/observability": "workspace:*",
    "@trustos/policy-engine": "workspace:*",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
